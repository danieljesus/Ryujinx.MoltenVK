From c0b43e38062825a15969be162bc52e48e6f5722c Mon Sep 17 00:00:00 2001
From: danieljesus <danieljesus@users.noreply.github.com>
Date: Wed, 25 Nov 2026 06:46:45 +0100
Subject: [PATCH 2/2] MSL: Inline precise arithmetic helpers before MSL 3.2 too

Before MSL 3.2 the precise add, sub and mul helpers stay [[clang::optnone]]
and are never inlined. Emit them instead as static inline always_inline
functions whose bodies start with #pragma clang fp contract(off). Metal's
compiler honours the clang pragma at MSL 2.0 to 3.2: the operations inside
the helper, and across the helper's boundary once it is inlined, are not
fused into fma. Safe math mode alone does not prevent that fusion, so the
pragma is what keeps the result exact.

MoltenVK compiles MSL 2.4 here, where every precise operation was a real
function call. On an Apple M6 (macOS 27.2.1) Ocarina of Time renders 33%
faster standing and 21% faster on a route with this change, with the same
Metal compile time.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RcHkcxd9kdiChCGMgXMqmQ
---
 spirv_msl.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index fa61c18c..6215f559 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -6018,8 +6018,8 @@ void CompilerMSL::emit_custom_templates()
 // From MSL 3.2 the body is compiled with safe math and without contraction
 // through the scoped fp pragmas, so every operation stays exactly as written
 // while the helper can still be inlined. Earlier MSL versions have no such
-// pragmas; there the helper is optnone, which keeps it exact but turns every
-// use into a real function call.
+// pragmas; there clang's own "#pragma clang fp contract(off)" keeps the
+// helper's operations from being contracted, and the helper is forced inline.
 void CompilerMSL::emit_precise_helper_begin(const char *signature)
 {
 	if (msl_options.supports_msl_version(3, 2))
@@ -6031,8 +6031,9 @@ void CompilerMSL::emit_precise_helper_begin(const char *signature)
 	}
 	else
 	{
-		statement("[[clang::optnone]] ", signature);
+		statement("static inline __attribute__((always_inline)) ", signature);
 		begin_scope();
+		statement("#pragma clang fp contract(off)");
 	}
 }
 
