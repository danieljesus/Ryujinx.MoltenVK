+        vec<T, Cols> tmp(0);
+        for (uint j = 0; j < Cols; ++j)
+        {
+            tmp[j] = m[j][i - 1];
+        }
+        res = fma(tmp, vec<T, Cols>(v[i - 1]), res);
+    }
+    return res;
+}
+
+template<typename T, int Cols, int Rows>
+vec<T, Rows> spvFMulMatrixVector(matrix<T, Cols, Rows> m, vec<T, Cols> v)
+{
+    #pragma metal fp math_mode(safe)
+    #pragma metal fp contract(off)
+    vec<T, Rows> res = vec<T, Rows>(T(-0.0));
+    for (uint i = Cols; i > 0; --i)
+    {
+        res = fma(m[i - 1], vec<T, Rows>(v[i - 1]), res);
+    }
+    return res;
+}
+
+template<typename T, int LCols, int LRows, int RCols, int RRows>
+matrix<T, RCols, LRows> spvFMulMatrixMatrix(matrix<T, LCols, LRows> l, matrix<T, RCols, RRows> r)
+{
+    #pragma metal fp math_mode(safe)
+    #pragma metal fp contract(off)
+    static_assert(LCols == RRows, "column-row configuration mismatch");
+    matrix<T, RCols, LRows> res;
+    for (uint i = 0; i < RCols; i++)
+    {
+        vec<T, LRows> tmp(T(-0.0));
+        for (uint j = 0; j < LCols; j++)
+        {
+            tmp = fma(vec<T, LRows>(r[i][j]), l[j], tmp);
+        }
+        res[i] = tmp;
+    }
+    return res;
+}
+
+template<typename T>
+T spvFAdd(T l, T r)
+{
+    #pragma metal fp math_mode(safe)
+    #pragma metal fp contract(off)
+    return fma(T(1), l, r);
+}
+
+template<typename T>
+T spvFSub(T l, T r)
+{
+    #pragma metal fp math_mode(safe)
+    #pragma metal fp contract(off)
+    return fma(T(-1), r, l);
+}
+
+struct main0_out
+{
+    float4 gl_Position [[position]];
+};
+
+struct main0_in
+{
+    float4 vA [[attribute(0)]];
+    float4 vB [[attribute(1)]];
+    float4 vC [[attribute(2)]];
+};
+
+vertex main0_out main0(main0_in in [[stage_in]])
+{
+    main0_out out = {};
+    float4 mul = spvFMul(in.vA, in.vB);
+    float4 add = spvFAdd(in.vA, in.vB);
+    float4 sub = spvFSub(in.vA, in.vB);
+    float4 mad = spvFAdd(spvFMul(in.vA, in.vB), in.vC);
+    float4 summed = spvFAdd(spvFAdd(spvFAdd(mul, add), sub), mad);
+    out.gl_Position = summed;
+    return out;
+}
+
diff --git a/shaders-msl/vert/no-contraction.msl32.vert b/shaders-msl/vert/no-contraction.msl32.vert
new file mode 100644
index 00000000..206fbf0d
--- /dev/null
+++ b/shaders-msl/vert/no-contraction.msl32.vert
@@ -0,0 +1,15 @@
+#version 450
+
+layout(location = 0) in vec4 vA;
+layout(location = 1) in vec4 vB;
+layout(location = 2) in vec4 vC;
+
+void main()
+{
+	precise vec4 mul = vA * vB;
+	precise vec4 add = vA + vB;
+	precise vec4 sub = vA - vB;
+	precise vec4 mad = vA * vB + vC;
+	precise vec4 summed = mul + add + sub + mad;
+	gl_Position = summed;
+}
