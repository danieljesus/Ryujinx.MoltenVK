diff --git a/reference/opt/shaders-msl/vert/no-contraction.msl32.vert b/reference/opt/shaders-msl/vert/no-contraction.msl32.vert
new file mode 100644
index 00000000..8fec231d
--- /dev/null
+++ b/reference/opt/shaders-msl/vert/no-contraction.msl32.vert
@@ -0,0 +1,101 @@
+#pragma clang diagnostic ignored "-Wmissing-prototypes"
+
+#include <metal_stdlib>
+#include <simd/simd.h>
+
+using namespace metal;
+
+template<typename T>
+T spvFMul(T l, T r)
+{
+    #pragma metal fp math_mode(safe)
+    #pragma metal fp contract(off)
+    return fma(l, r, T(-0.0));
+}
+
+template<typename T, int Cols, int Rows>
+vec<T, Cols> spvFMulVectorMatrix(vec<T, Rows> v, matrix<T, Cols, Rows> m)
+{
+    #pragma metal fp math_mode(safe)
+    #pragma metal fp contract(off)
+    vec<T, Cols> res = vec<T, Cols>(T(-0.0));
+    for (uint i = Rows; i > 0; --i)
+    {
+        vec<T, Cols> tmp(0);
+        for (uint j = 0; j < Cols; ++j)
+        {
+            tmp[j] = m[j][i - 1];
+        }
+        res = fma(tmp, vec<T, Cols>(v[i - 1]), res);
+    }
+    return res;
+}
+
+template<typename T, int Cols, int Rows>
+vec<T, Rows> spvFMulMatrixVector(matrix<T, Cols, Rows> m, vec<T, Cols> v)
+{
+    #pragma metal fp math_mode(safe)
+    #pragma metal fp contract(off)
+    vec<T, Rows> res = vec<T, Rows>(T(-0.0));
+    for (uint i = Cols; i > 0; --i)
+    {
+        res = fma(m[i - 1], vec<T, Rows>(v[i - 1]), res);
+    }
+    return res;
+}
+
+template<typename T, int LCols, int LRows, int RCols, int RRows>
+matrix<T, RCols, LRows> spvFMulMatrixMatrix(matrix<T, LCols, LRows> l, matrix<T, RCols, RRows> r)
+{
+    #pragma metal fp math_mode(safe)
+    #pragma metal fp contract(off)
+    static_assert(LCols == RRows, "column-row configuration mismatch");
+    matrix<T, RCols, LRows> res;
+    for (uint i = 0; i < RCols; i++)
+    {
+        vec<T, LRows> tmp(T(-0.0));
+        for (uint j = 0; j < LCols; j++)
+        {
+            tmp = fma(vec<T, LRows>(r[i][j]), l[j], tmp);
+        }
+        res[i] = tmp;
+    }
+    return res;
+}
+
+template<typename T>
+T spvFAdd(T l, T r)
+{
+    #pragma metal fp math_mode(safe)
+    #pragma metal fp contract(off)
+    return fma(T(1), l, r);
+}
+
+template<typename T>
+T spvFSub(T l, T r)
+{
+    #pragma metal fp math_mode(safe)
+    #pragma metal fp contract(off)
+    return fma(T(-1), r, l);
+}
+
+struct main0_out
+{
+    float4 gl_Position [[position]];
+};
+
+struct main0_in
+{
+    float4 vA [[attribute(0)]];
+    float4 vB [[attribute(1)]];
+    float4 vC [[attribute(2)]];
+};
+
+vertex main0_out main0(main0_in in [[stage_in]])
+{
+    main0_out out = {};
+    float4 _15 = spvFMul(in.vA, in.vB);
+    out.gl_Position = spvFAdd(spvFAdd(spvFAdd(_15, spvFAdd(in.vA, in.vB)), spvFSub(in.vA, in.vB)), spvFAdd(_15, in.vC));
+    return out;
+}
+
